{
	"name": "decorator-toolkit",
	"description": "Modern TC39 decorators for reducing repetitive code.",
	"type": "module",
	"version": "0.4.0",
	"license": "Apache-2.0",
	"funding": "https://github.com/sponsors/xseman",
	"homepage": "https://github.com/xseman/decorator-toolkit",
	"keywords": [
		"typescript",
		"decorator",
		"tc39",
		"resilience",
		"retry",
		"cache",
		"rate-limit",
		"circuit-breaker"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/xseman/decorator-toolkit"
	},
	"scripts": {
		"prebuild": "node -e \"fs.rmSync('lib',{recursive:true,force:true})\"",
		"build": "tsc --build",
		"fmt": "dprint fmt",
		"fmt:check": "dprint check",
		"typecheck": "tsc --noEmit",
		"typecheck:test": "tsc -p tsconfig.test.json",
		"test": "bun test src/ --coverage --coverage-reporter=text --coverage-reporter=lcov --concurrent",
		"test:watch": "bun test src/ --watch --coverage --concurrent"
	},
	"devDependencies": {
		"@types/bun": "^1.4.2",
		"@types/node": "^24.13.3",
		"dprint": "~0.57.4",
		"typescript": "~7.0.2"
	},
	"engines": {
		"node": ">=22",
		"bun": ">=1.3"
	},
	"sideEffects": false,
	"types": "./src/index.ts",
	"exports": {
		"./package.json": "./package.json",
		".": {
			"types": "./src/index.ts",
			"bun": "./src/index.ts",
			"import": "./lib/index.js",
			"require": "./lib/index.js"
		},
		"./*": {
			"types": "./src/*/index.ts",
			"bun": "./src/*/index.ts",
			"import": "./lib/*/index.js",
			"require": "./lib/*/index.js"
		}
	},
	"files": [
		"lib/**/*.js",
		"!lib/**/*_test*",
		"src/**/*.ts",
		"!src/**/*_test.ts"
	]
}
